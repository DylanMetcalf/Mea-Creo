# Mea Creo — environment template.
# Copy to .env.local for development. Never commit real values.
# Every variable is documented in docs/ENVIRONMENT.md.

# --- Core --------------------------------------------------------------------
# development | test | staging | production. Production refuses mock adapters.
APP_ENV=development
LOG_LEVEL=info
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000/app

# --- Database (Phase 2) ------------------------------------------------------
# Matches docker-compose.yml for local development.
DATABASE_URL=postgres://meacreo:meacreo@localhost:5432/meacreo

# --- Auth & secrets (Phase 3) ------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# 32-byte key, base64. Encrypts OAuth tokens at rest. openssl rand -base64 32
ENCRYPTION_KEY=
# Google OAuth client — sign-in, Calendar, Search Console, Analytics.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- AI (Phase 17) -----------------------------------------------------------
# none (rules mode) | mock | anthropic | openai | google
AI_PROVIDER=mock
AI_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=
AI_MONTHLY_BUDGET_USD=50

# --- Email -------------------------------------------------------------------
# mock | smtp | resend. For local previews use smtp with Mailpit: smtp://localhost:1025
EMAIL_PROVIDER=mock
EMAIL_FROM="Mea Creo <no-reply@meacreo.co.za>"
SMTP_URL=
RESEND_API_KEY=

# --- File storage ------------------------------------------------------------
# mock | s3 (any S3-compatible store: AWS S3, Cloudflare R2, Supabase, MinIO)
STORAGE_PROVIDER=mock
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=meacreo-dev
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Payments (Phase 14) -----------------------------------------------------
# none | mock | payfast
PAYMENT_PROVIDER=mock
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=true

# --- Accounting --------------------------------------------------------------
# none | mock | xero
ACCOUNTING_PROVIDER=none
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=

# --- Calendar / analytics / search / CRM / social ----------------------------
# none | mock | google
CALENDAR_PROVIDER=mock
ANALYTICS_PROVIDER=mock
SEARCH_PROVIDER=mock
# none | mock | sales_scout
CRM_PROVIDER=none
SALES_SCOUT_WEBHOOK_SECRET=

# none | mock | linkedin
SOCIAL_PROVIDER=none

# --- Scheduling ---------------------------------------------------------------
# Only needed on hosts without `pnpm worker` (e.g. Vercel Cron). Generate: openssl rand -base64 32
CRON_SECRET=

# --- Feature flags (all default off) -----------------------------------------
FEATURE_XERO=false
FEATURE_PAYFAST=false
FEATURE_GOOGLE_ANALYTICS=false
FEATURE_GSC=false
FEATURE_AI_AUTOMATION=false
FEATURE_SALES_SCOUT=false
FEATURE_CLIENT_AI=false
FEATURE_SELF_SERVICE=false
FEATURE_LINKEDIN=false

# --- Testing -----------------------------------------------------------------
# Optional: use a pre-installed Chromium for Playwright instead of a downloaded one.
# PLAYWRIGHT_CHROMIUM_EXECUTABLE=
